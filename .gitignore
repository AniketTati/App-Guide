# Grown as we go -- add things when they actually show up, not speculatively.

# --- macOS ---
.DS_Store
._*
.Spotlight-V100
.Trashes

# --- Editors ---
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json

# --- Environment & secrets (this repo is public) ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Node ---
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Local agent state (machine-specific) ---
.claude/settings.local.json

.appguide/

# --- note ---
# .appguide/ holds the local session mark. It is deliberately NOT committed:
# a mark is "the last time you looked", which is per-machine. An earlier design
# committed a blueprint here; that design is gone (docs/decisions.md #49).

# recall benchmark corpus (bench/express/run.sh)
.bench-work/
