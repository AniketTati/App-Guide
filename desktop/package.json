{
  "name": "appguide-desktop",
  "productName": "App Guide",
  "version": "0.1.0",
  "private": true,
  "description": "What needs you, what is in flight, and a Check before anything merges — for the person who owns an agent-built product.",
  "author": "Aniket Tatipamula",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build:node": "tsup",
    "build:renderer": "vite build",
    "build": "pnpm build:node && pnpm build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:server": "node dist/devserver.cjs",
    "dev:renderer": "vite",
    "start": "electron .",
    "package": "bash scripts/pack.sh"
  },
  "dependencies": {
    "ts-morph": "^24.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "^12",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "dev.appguide.desktop",
    "productName": "App Guide",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dir"
      ],
      "identity": null,
      "hardenedRuntime": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}
